# systemd *user* service: runs the dashboard server as ahmckeit.
# Installed by symlinking into ~/.config/systemd/user/
[Unit]
Description=Kitchen Dashboard web server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/kitchen-dashboard
ExecStart=%h/kitchen-dashboard/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-access-log --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
